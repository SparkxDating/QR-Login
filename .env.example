# Required for /admin. No default password exists.
ADMIN_PASSWORD=

# Optional. If unset, derived from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# Optional. Used only for admin password recovery. Leave empty here — set the real value in the host environment, never in git.
ADMIN_RECOVERY_CODE=

# Optional Super Admin. Username + password, both required to enable. Leave empty here — set real values in the host environment, never in git.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# Required on deploy (Neon/Postgres). Local preview uses embedded PGLite.
DATABASE_URL=
